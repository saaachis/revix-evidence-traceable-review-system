# Copy to .env and fill in. NEVER commit .env — this repository is public.

# ---------- database ----------
# One PostgreSQL instance with the pgvector extension (Supabase or Neon free tier)
DATABASE_URL=postgresql+psycopg://user:password@host:5432/revix
DATABASE_URL_SYNC=postgresql://user:password@host:5432/revix

# ---------- api ----------
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development                 # development | production
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- web ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---------- language model ----------
# Batch narration only. The application must render a complete verdict with this off.
LLM_ENABLED=false
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# ---------- source connectors ----------
# Official APIs where they exist. Leave blank to disable that connector.
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=revix/0.1 (academic project; contact: <email>)

# Politeness defaults applied by the connector framework
DEFAULT_RATE_LIMIT_RPM=20
DEFAULT_REQUEST_TIMEOUT_S=30
USER_AGENT=revix/0.1 (+https://github.com/saaachis/revix-evidence-traceable-review-system)

# ---------- orchestration ----------
PREFECT_API_URL=

# ---------- observability ----------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# ---------- admin ----------
ADMIN_USERNAME=
ADMIN_PASSWORD=
